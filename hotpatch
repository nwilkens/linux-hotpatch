#!/usr/bin/env bash
# Build and manage kernel livepatches for the running kernel.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
# shellcheck source=lib/cve.sh
source "$HERE/lib/cve.sh"
# shellcheck source=lib/kpatch.sh
source "$HERE/lib/kpatch.sh"
# shellcheck source=lib/livepatch.sh
source "$HERE/lib/livepatch.sh"

DEPS=(build-essential curl patch libelf-dev libssl-dev bison flex bc dwarves zstd git
	dpkg-dev kmod python3 binutils elfutils rsync cpio gpgv ubuntu-keyring)

usage() {
	cat >&2 <<USAGE
usage: hotpatch <command> [args]
  deps                      install build dependencies (apt)
  prepare                   fetch kernel source and debug vmlinux, build kpatch-build
  fetch-patch <CVE-ID>      pick the upstream fix that applies to the source tree
  inspect <CVE-ID|patch>    summarise the change: files, functions, objects, review items
  build <CVE-ID> [kpatch-build args]
                            fetch the fix for <CVE-ID> and build it as cve_yyyy_nnnnn
  build <name> <patch> [kpatch-build args]
                            build livepatch module <name> from <patch>
  load <module.ko>          insert livepatch and wait for the transition
  unload <name>             disable and remove a loaded livepatch
  status                    show loaded livepatches
  env                       print detected kernel and paths
USAGE
	exit 2
}

cmd="${1:-}"; shift || true
case "$cmd" in
	deps)
		need_root
		DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${DEPS[@]}"
		;;
	prepare)
		need_root; backend_load; backend_detect
		backend_fetch_source
		kpatch_install
		backend_fetch_vmlinux
		;;
	fetch-patch)
		[[ $# -eq 1 ]] || usage
		need_root; backend_load; backend_detect
		cve_fetch_patch "$1"
		;;
	inspect)
		[[ $# -eq 1 ]] || usage
		need_root; backend_load; backend_detect
		if is_cve_id "$1"; then
			cve_fetch_patch "$1"; p="$(cve_patch_path "$1")"
		else
			p="$1"
		fi
		python3 -I "$HERE/scripts/inspect-patch.py" --src "$SRC_TREE" --config "$CONFIG" "$p"
		;;
	build)
		[[ $# -ge 1 ]] || usage
		need_root; backend_load; backend_detect
		if is_cve_id "$1" && { [[ $# -eq 1 ]] || [[ "$2" == -* ]]; }; then
			id="$1"; shift
			cve_fetch_patch "$id"
			kpatch_build "$(cve_module_name "$id")" "$(cve_patch_path "$id")" "$@"
		else
			[[ $# -ge 2 ]] || usage
			kpatch_build "$@"
		fi
		;;
	load)   [[ $# -eq 1 ]] || usage; need_root; backend_load; backend_detect; lp_load "$1" ;;
	unload) [[ $# -eq 1 ]] || usage; need_root; lp_unload "$1" ;;
	status) lp_status ;;
	env)    backend_load; backend_detect; printf 'SRC_TREE=%s\nVMLINUX=%s\nCONFIG=%s\n' "$SRC_TREE" "$VMLINUX" "$CONFIG" ;;
	*) usage ;;
esac
